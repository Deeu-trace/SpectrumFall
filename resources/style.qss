/* 全局霓虹风格 QSS — SpectrumFall 主题 */

/* 全局背景 */
QWidget {
    background-color: #1a1a2e;
    color: #e0e0e0;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
}

/* 主窗口 */
QMainWindow {
    background-color: #1a1a2e;
}

/* QStackedWidget */
QStackedWidget {
    background-color: #1a1a2e;
}

/* ═══════════════ 按钮通用 ═══════════════ */
QPushButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #1c2e50, stop:1 #131d35);
    color: #c8d8e8;
    border: 1px solid #1e3560;
    border-radius: 8px;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 500;
    min-height: 22px;
}

QPushButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #284878, stop:1 #1c3858);
    border: 1px solid #00ff88;
    color: #00ff88;
}

QPushButton:pressed {
    background-color: #0c1628;
    border: 1px solid #00cc6a;
    color: #00cc6a;
    padding: 12px 22px 8px 22px;
}

QPushButton:disabled {
    background-color: #10162a;
    color: #3a3a50;
    border: 1px solid #141a30;
}

/* ═══════════════ 菜单按钮（主操作） ═══════════════ */
QPushButton#menuButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 rgba(0,255,136,12), stop:0.5 rgba(15,52,96,200), stop:1 rgba(139,233,253,10));
    color: #00ff88;
    border: 2px solid rgba(0,255,136,90);
    border-radius: 10px;
    padding: 14px 40px;
    font-size: 18px;
    font-weight: bold;
    min-height: 28px;
}

QPushButton#menuButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 rgba(0,255,136,45), stop:0.5 rgba(20,80,140,230), stop:1 rgba(139,233,253,35));
    border: 2px solid #00ff88;
    color: #eeffee;
}

QPushButton#menuButton:pressed {
    background-color: rgba(0,255,136,60);
    border: 2px solid #00cc6a;
    color: #00ff88;
    padding: 16px 40px 12px 40px;
}

QPushButton#menuButton:disabled {
    background-color: #10162a;
    color: #3a3a50;
    border: 2px solid #141a30;
}

/* ═══════════════ 动作按钮 ═══════════════ */
QPushButton#actionButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #1a3a6e, stop:1 #0f2a52);
    color: #00ff88;
    border: 1px solid rgba(0,255,136,70);
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
    min-height: 22px;
}

QPushButton#actionButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #2a5a9e, stop:1 #1a4a80);
    border: 1px solid #00ff88;
    color: #eeffee;
}

QPushButton#actionButton:pressed {
    background-color: #0a1a3a;
    border: 1px solid #00cc6a;
    padding: 12px 20px 8px 20px;
}

QPushButton#actionButton:disabled {
    background-color: #10162a;
    color: #3a3a50;
    border: 1px solid #141a30;
}

/* ═══════════════ 返回按钮 ═══════════════ */
QPushButton#backButton {
    background-color: rgba(189,147,249,5);
    color: #bd93f9;
    border: 1px solid rgba(189,147,249,55);
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 14px;
    min-height: 22px;
}

QPushButton#backButton:hover {
    background-color: rgba(189,147,249,25);
    border: 1px solid #bd93f9;
    color: #d4b8ff;
}

QPushButton#backButton:pressed {
    background-color: rgba(189,147,249,50);
    border: 1px solid #a070e0;
    color: #a070e0;
    padding: 12px 20px 8px 20px;
}

QPushButton#backButton:disabled {
    background-color: #10162a;
    color: #3a3a50;
    border: 1px solid #141a30;
}

/* ═══════════ 带图标按钮 — 图标下移微调 ═══════════ */
/* 调整方法: 修改 padding-top 数值即可 (当前 12px = 原10px + 2px下移) */
QPushButton[iconPad="true"] {
    padding-top: 12px;
}
QPushButton#menuButton[iconPad="true"] {
    padding-top: 16px;
}

/* ═══════════════ 播放按钮 ═══════════════ */
QPushButton#playButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #1c2e50, stop:1 #131d35);
    color: #e0e0e0;
    border: 1px solid #1e3560;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton#playButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #284878, stop:1 #1c3858);
    border: 1px solid #00ff88;
    color: #00ff88;
}

/* 滑块 */
QSlider::groove:horizontal {
    height: 6px;
    background: #16213e;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #00ff88;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #0f3460;
    border-radius: 3px;
}

/* 下拉框 */
QComboBox {
    background-color: #0f3460;
    color: #e0e0e0;
    border: 1px solid #16213e;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #00ff88;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    selection-background-color: #0f3460;
    selection-color: #00ff88;
}

/* 歌曲列表 */
QListWidget#songList {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QListWidget#songList::item {
    padding: 8px;
    border-radius: 4px;
}

QListWidget#songList::item:selected {
    background-color: #0f3460;
    color: #00ff88;
}

QListWidget#songList::item:hover {
    background-color: #1a2a4a;
}

/* 控制面板 */
QWidget#controlPanel {
    background-color: #16213e;
    border-top: 1px solid #0f3460;
    border-radius: 4px;
}

/* 统计面板 */
QWidget#statsPanel {
    background-color: #16213e;
    border: 1px solid #0f3460;
    border-radius: 8px;
    padding: 15px;
}

/* 进度条 */
QProgressBar {
    background-color: #16213e;
    border: 1px solid #0f3460;
    border-radius: 6px;
    text-align: center;
    color: #0f3460;
    font-size: 12px;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #00cc77;
    border-radius: 5px;
}

/* 标签 */
QLabel {
    background: transparent;
}

/* 滚动条 */
QScrollBar:vertical {
    background: #1a1a2e;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #0f3460;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 列表通用 */
QListWidget {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: #0f3460;
    color: #00ff88;
}

/* 历史记录列表 */
QListWidget#historyList {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    font-size: 13px;
}

QListWidget#historyList::item {
    padding: 8px 12px;
    border-radius: 4px;
    border-bottom: 1px solid #0f3460;
}

QListWidget#historyList::item:selected {
    background-color: #0f3460;
    color: #00ff88;
    border-color: #00ff88;
}

QListWidget#historyList::item:hover {
    background-color: #1a2a4a;
}

QListWidget#historyList::item:disabled {
    color: #666666;
}
